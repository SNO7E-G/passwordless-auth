{
  "name": "passwordless-auth",
  "version": "1.0.0",
  "description": "A secure and flexible library for passwordless authentication using magic links and OTPs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "prepare": "npm run build",
    "docs": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SNO7E-G/passwordless-auth.git"
  },
  "keywords": [
